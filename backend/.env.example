# VigilNet Backend Configuration Example

PORT=3000

# Neo4j AuraDB credentials (for graph analytics and path risk checking)
NEO4J_URI=neo4j+s://<YOUR_NEO4J_DB_ID>.databases.neo4j.io
NEO4J_USER=neo4j
NEO4J_PASSWORD=<YOUR_NEO4J_PASSWORD>

# PostgreSQL connection string (for relational logs and access sessions)
DATABASE_URL=postgresql://<DB_USER>:<DB_PASSWORD>@<DB_HOST>:<DB_PORT>/vigilnet

# Gemini API Key (for document manifest structured JSON OCR extraction)
GEMINI_API_KEY=<YOUR_GEMINI_API_KEY>

# Sarvam AI API Key (for speech-to-text translation of local testimonies)
SARVAM_API_KEY=<YOUR_SARVAM_API_KEY>
